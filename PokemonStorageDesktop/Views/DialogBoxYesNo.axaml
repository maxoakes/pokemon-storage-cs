<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200"
        SizeToContent="WidthAndHeight"
        x:Class="PokemonStorageDesktop.Views.DialogBoxYesNo"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
        CanMaximize="False"
        Title="Message">
    <Window.Styles>
        <Style Selector="Border#Container">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="Background" Value="{StaticResource WhiteBackgroundColor}"/>
        </Style>
        <Style Selector="StackPanel > WrapPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel > TextBlock">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkTextColor}"/>
        </Style>
        <Style Selector="TextBox.InteractControl">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Height" Value="{StaticResource InteractionControlHeight}"/>
        </Style>
        <Style Selector="Button.Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="{StaticResource LightAccentColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.Button > ContentPresenter">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Styles>

    <Border Name="Container">
        <StackPanel>
            <TextBlock x:Name="lblContent" Name="Header" Text="Dialog text" TextWrapping="Wrap" />
            <WrapPanel x:Name="buttonContainer">
                <Button x:Name="btnYes" Classes="Button" Content="Yes" Click="Yes_Click" />
                <Button x:Name="btnNo" Classes="Button" Content="No" Click="No_Click" />
                <Button x:Name="btnCancel" Classes="Button" Content="Cancel" Click="Cancel_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
