<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PokemonStorageDesktop.ViewModels"
        xmlns:local="using:PokemonStorageDesktop.UserControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="PokemonStorageDesktop.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Pokemon Storage"
        Width="800" 
        Height="600">
    <Window.Styles>
        <!-- Tabs -->
        <Style Selector="TabControl.PrimaryTabControl > TabItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="200"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl > TabItem TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkTextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource PrimaryTextSize}"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl > TabItem > StackPanel">
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl > TabItem:selected">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBackgroundColor}"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl > TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource LightAccentColor}"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl > TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource LightAccentColor}"/>
        </Style>
        <Style Selector="Image.Tab">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Tab Content -->
        <Style Selector="TabControl.PrimaryTabControl">
            <Setter Property="Background" Value="{StaticResource WhiteBackgroundColor}"/>
        </Style>
        <Style Selector="TabControl.PrimaryTabControl /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="Background" Value="{StaticResource LightBackgroundColor}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Bottom Panel -->
        <Style Selector="WrapPanel#OpenWrapPanel">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Styles>
    <Grid>
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right">
                <local:AboutPanel x:Name="AboutPanel" Name="AboutPanel" />
            </Border>
            <TabControl x:Name="tabControl" Classes="PrimaryTabControl" TabStripPlacement="Left">
            </TabControl>
        </DockPanel>
        <WrapPanel Name="OpenWrapPanel" Classes="BottomTransparentPanel">
            <SplitButton 
                x:Name="btnOpen"
                Classes="Accented"
                Name="OpenSaveFileDefault"
                Content="Open Save File" 
                Click="OpenSource_Click">
                <SplitButton.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem x:Name="itemOpenSaveFile" Name="OpenSaveFile" Header="Open Save File" Click="OpenSource_Click"/>
                        <MenuItem x:Name="itemOpenDatabase" Name="OpenDatabase" Header="Open Database (Advanced)" Click="OpenSource_Click"/>
                        <MenuItem x:Name="itemDeleteSelectedSource" Name="DeleteSelectedSource" Header="Remove Selected Tab" Click="OpenSource_Click"/>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </WrapPanel>
    </Grid>
</Window>
