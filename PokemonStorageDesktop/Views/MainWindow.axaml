<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PokemonStorageDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="PokemonStorageDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PokemonStorageDesktop"
        Width="1600" 
        Height="900">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <DockPanel LastChildFill="True">
        <Border Background="Orange" Width="250" DockPanel.Dock="Right">
            <StackPanel>
                <TextBlock Foreground="Black">Pokemon Name</TextBlock>
                <TextBlock Foreground="Black">Nickname</TextBlock>
                <TextBlock Foreground="Black">Description</TextBlock>
            </StackPanel>
        </Border>
        <TabControl TabStripPlacement="Left">
            <TabItem Header="File">
                <Grid RowDefinitions="*, Auto">
                    <ScrollViewer Name="FileGridParent">
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" Height="32" Background="Olive">
                        <SplitButton 
                            HorizontalAlignment="Right"
                            Content="Export to Database" 
                            Name="ExportToDatabaseButton"
                            Click="ExportSelected_Click">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuItem 
                                        Name="ExportToJsonButton"
                                        Header="Export to JSON"
                                        Click="ExportSelected_Click"/>
                                    <MenuItem 
                                        Name="ExportToPokemonShowdownButton"
                                        Header="Export to PokemonShowdown"
                                        Click="ExportSelected_Click"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="DB">
                <Grid RowDefinitions="*, Auto">
                    <ScrollViewer Name="DatabaseGridParent">
                        <WrapPanel Name="Database">
                        </WrapPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" Height="32" Background="Olive">
                        <SplitButton 
                            HorizontalAlignment="Right"
                            Content="Import from Database to Save File" 
                            Name="ImportFromDatabaseButton"
                            Click="ImportSelected_Click">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuItem 
                                        Name="DatabaseExportToJsonButton"
                                        Header="Export to JSON"
                                        Click="ImportSelected_Click"/>
                                    <MenuItem 
                                        Name="DatabaseExportToPokemonShowdownButton"
                                        Header="Export to PokemonShowdown"
                                        Click="ImportSelected_Click"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
