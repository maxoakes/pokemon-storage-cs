<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PokemonStorageDesktop.App"
             xmlns:local="using:PokemonStorageDesktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryVariableColor">Red</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryVariableColor">Orange</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryDarkTextColor">Black</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryDarkTextColor">#222</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryLightTextColor">White</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryLightTextColor">LightGray</SolidColorBrush>
        <SolidColorBrush x:Key="LightAccentColor">#87986a</SolidColorBrush>
        <SolidColorBrush x:Key="LightAccentColorAlternate">#718355</SolidColorBrush>
        <SolidColorBrush x:Key="WhiteBackgroundColor">#e9f5db</SolidColorBrush>
        <SolidColorBrush x:Key="LightBackgroundColor">#cfe1b9</SolidColorBrush>
        <SolidColorBrush x:Key="MediumBackgroundColor">#97a97c</SolidColorBrush>
        <x:String x:Key="AboutPanelBoxShadow">0 4 12 #200000</x:String>
        <SolidColorBrush x:Key="UNSET_COLOR">Magenta</SolidColorBrush>
        <x:Double x:Key="InteractionControlHeight">30</x:Double>
        <CornerRadius x:Key="StandardCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="SmallCornerRadius">2</CornerRadius>
        <CornerRadius x:Key="TinyCornerRadius">1</CornerRadius>
        <CornerRadius x:Key="CardImageCornerRadius">4 4 0 0</CornerRadius>
        <x:Double x:Key="HeaderTextSize">22</x:Double>
        <x:Double x:Key="SubheaderTextSize">18</x:Double>
        <x:Double x:Key="NormalTextSize">14</x:Double>
        <x:Double x:Key="SmallTextSize">10</x:Double>
        <x:Double x:Key="TinyTextSize">8</x:Double>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />

        <!-- Panel Split Button -->
        <Style Selector="WrapPanel.BottomTransparentPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="SplitButton.Accented, Button.Accented">
            <Setter Property="Background" Value="{StaticResource LightAccentColor}"/>
        </Style>
        <Style Selector="SplitButton.Accented">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style Selector="SplitButton.Accented:pointerover, SplitButton.Accented:pressed, Button.Accented:pointerover, Button.Accented:pressed">
            <Setter Property="Background" Value="{StaticResource LightAccentColorAlternate}"/>
        </Style>
        <Style Selector="SplitButton.Accented /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="SplitButton.Accented /template/ Button#PART_PrimaryButton /template/ ContentPresenter:pointerover">
            <Setter Property="Background" Value="{StaticResource LightAccentColorAlternate}"/>
        </Style>
        <Style Selector="SplitButton.Accented /template/ Button#PART_SecondaryButton /template/ ContentPresenter:pointerover">
            <Setter Property="Background" Value="{StaticResource LightAccentColorAlternate}"/>
        </Style>

        <!-- Shadows -->
        <Style Selector="Border.VerticalShadow">
            <Setter Property="BoxShadow" Value="0 4 12 rgba(15, 15, 15, 0.75)"/>
        </Style>
        <Style Selector="Border.PanelShadow">
            <Setter Property="BoxShadow" Value="4 4 8 rgba(15, 15, 15, .75)"/>
        </Style>
        <Style Selector="Border.SmallShadow">
            <Setter Property="BoxShadow" Value="2 2 4 rgba(15, 15, 15, 0.75)"/>
        </Style>

    </Application.Styles>

</Application>